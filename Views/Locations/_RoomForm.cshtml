@model Room
<div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="mb-3"><label asp-for="ApartmentId" class="form-label">الشقة</label><select asp-for="ApartmentId" class="form-select">@foreach(var a in ViewBag.Apartments){<option value="@a.Id">@a.Building.Site.Name — عمارة @a.Building.Number — شقة @a.Number</option>}</select></div><div class="mb-3"><label asp-for="Number" class="form-label">رقم الغرفة</label><input asp-for="Number" class="form-control" type="number" /></div><div class="form-check"><input asp-for="IsOccupied" class="form-check-input" /><label asp-for="IsOccupied" class="form-check-label">مشغولة</label></div>
