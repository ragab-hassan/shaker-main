@model IEnumerable<Site>
<div class="d-flex justify-content-between align-items-center mb-3"><h2>السكن والعمارات</h2><a class="btn btn-primary" asp-action="CreateSite">+ موقع جديد</a></div>
@foreach(var s in Model){<div class="card mb-4 shadow-sm"><div class="card-header d-flex justify-content-between align-items-center"><div><b>@s.Name</b> <span class="text-muted">— @s.Address</span></div><div><span class="badge bg-secondary">@s.Buildings.Count عمارة</span> <a class="btn btn-sm btn-outline-primary" asp-action="EditSite" asp-route-id="@s.Id">تعديل</a> <a class="btn btn-sm btn-outline-danger" asp-action="DeleteSite" asp-route-id="@s.Id" onclick="return confirm('حذف الموقع بكل ما بداخله؟')">حذف</a></div></div><div class="card-body">
@foreach(var b in s.Buildings){<div class="border rounded p-3 mb-3"><div class="d-flex justify-content-between align-items-center"><div><b>عمارة @b.Number</b> — @b.Name <span class="text-muted">(@b.Apartments.Count شقة / @b.Apartments.Sum(a=>a.Rooms.Count) غرفة)</span></div><div><a class="btn btn-sm btn-outline-secondary" asp-action="EditBuilding" asp-route-id="@b.Id">تعديل</a> <a class="btn btn-sm btn-outline-danger" asp-action="DeleteBuilding" asp-route-id="@b.Id" onclick="return confirm('حذف العمارة بكل الشقق والغرف؟')">حذف</a> <a class="btn btn-sm btn-outline-primary" asp-action="CreateApartment" asp-route-buildingId="@b.Id">+ شقة</a></div></div>
<div class="row g-2 mt-2">@foreach(var a in b.Apartments){<div class="col-lg-3 col-md-4"><div class="bg-light rounded p-2"><div class="d-flex justify-content-between"><b>شقة @a.Number</b><div><a class="btn btn-sm btn-link p-0" asp-action="EditApartment" asp-route-id="@a.Id">تعديل</a> <a class="btn btn-sm btn-link text-danger p-0" asp-action="DeleteApartment" asp-route-id="@a.Id" onclick="return confirm('حذف الشقة بكل الغرف؟')">حذف</a> <a class="btn btn-sm btn-outline-secondary" asp-action="CreateRoom" asp-route-apartmentId="@a.Id">+ غرفة</a></div></div><div class="small mt-2">@a.Rooms.Count غرفة — @a.Rooms.Count(r=>r.IsOccupied) مشغولة — @a.Rooms.Count(r=>!r.IsOccupied) فارغة</div><div class="small mt-2">@foreach(var r in a.Rooms){<span class="badge @(r.IsOccupied ? "bg-danger" : "bg-success") me-1 mb-1">@r.Number <a class="text-white text-decoration-none" asp-action="EditRoom" asp-route-id="@r.Id">✎</a> <a class="text-white text-decoration-none" asp-action="DeleteRoom" asp-route-id="@r.Id" onclick="return confirm('حذف الغرفة؟')">×</a></span>}</div></div></div>}</div></div>}
<a class="btn btn-sm btn-outline-primary" asp-action="CreateBuilding" asp-route-siteId="@s.Id">+ إضافة عمارة</a></div></div>}
