@model IEnumerable<Site>
<div class="d-flex justify-content-between align-items-center mb-3"><h2>السكن والعمارات</h2><a class="btn btn-primary" asp-action="CreateSite">+ موقع جديد</a></div>
@foreach (var site in Model)
{
    <div class="card mb-4 shadow-sm">
        <div class="card-header d-flex justify-content-between align-items-center">
            <div><b>@site.Name</b> <span class="text-muted">— @site.Address</span></div>
            <div>
                <span class="badge bg-secondary">@site.Buildings.Count عمارة</span>
                <a class="btn btn-sm btn-outline-primary" asp-action="EditSite" asp-route-id="@site.Id">تعديل</a>
                <form asp-action="DeleteSite" asp-route-id="@site.Id" method="post" class="d-inline" onsubmit="return confirm('حذف الموقع بكل ما بداخله؟')">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-outline-danger">حذف</button>
                </form>
            </div>
        </div>
        <div class="card-body">
            @foreach (var building in site.Buildings)
            {
                <div class="border rounded p-3 mb-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div><b>عمارة @building.Number</b> — @building.Name <span class="text-muted">(@building.Apartments.Count شقة / @building.Apartments.Sum(apartment => apartment.Rooms.Count) غرفة)</span></div>
                        <div>
                            <a class="btn btn-sm btn-outline-secondary" asp-action="EditBuilding" asp-route-id="@building.Id">تعديل</a>
                            <form asp-action="DeleteBuilding" asp-route-id="@building.Id" method="post" class="d-inline" onsubmit="return confirm('حذف العمارة بكل الشقق والغرف؟')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">حذف</button>
                            </form>
                            <a class="btn btn-sm btn-outline-primary" asp-action="CreateApartment" asp-route-buildingId="@building.Id">+ شقة</a>
                        </div>
                    </div>
                    <div class="row g-2 mt-2">
                        @foreach (var apartment in building.Apartments)
                        {
                            <div class="col-lg-3 col-md-4">
                                <div class="bg-light rounded p-2">
                                    <div class="d-flex justify-content-between">
                                        <b>شقة @apartment.Number</b>
                                        <div>
                                            <a class="btn btn-sm btn-link p-0" asp-action="EditApartment" asp-route-id="@apartment.Id">تعديل</a>
                                            <form asp-action="DeleteApartment" asp-route-id="@apartment.Id" method="post" class="d-inline" onsubmit="return confirm('حذف الشقة بكل الغرف؟')">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-link text-danger p-0">حذف</button>
                                            </form>
                                            <a class="btn btn-sm btn-outline-secondary" asp-action="CreateRoom" asp-route-apartmentId="@apartment.Id">+ غرفة</a>
                                        </div>
                                    </div>
                                    <div class="small mt-2">@apartment.Rooms.Count غرفة — @apartment.Rooms.Count(room => room.IsOccupied) مشغولة — @apartment.Rooms.Count(room => !room.IsOccupied) فارغة</div>
                                    <div class="small mt-2">
                                        @foreach (var room in apartment.Rooms)
                                        {
                                            <span class="badge @(room.IsOccupied ? "bg-danger" : "bg-success") me-1 mb-1">
                                                @room.Number
                                                <a class="text-white text-decoration-none" asp-action="EditRoom" asp-route-id="@room.Id">✎</a>
                                            </span>
                                            <form asp-action="DeleteRoom" asp-route-id="@room.Id" method="post" class="d-inline" onsubmit="return confirm('حذف الغرفة؟')">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-link text-danger text-decoration-none p-0 align-baseline">×</button>
                                            </form>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
            <a class="btn btn-sm btn-outline-primary" asp-action="CreateBuilding" asp-route-siteId="@site.Id">+ إضافة عمارة</a>
        </div>
    </div>
}
