@model IEnumerable<AppRole>

<div class="roles-page">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h2 class="mb-1">الأدوار والصلاحيات</h2>
            <p class="text-muted mb-0">إدارة الأدوار وتحديد الصلاحيات المسموح بها لكل مستخدم.</p>
        </div>
        <a asp-action="Create" class="btn btn-success px-4">
            <i class="bi bi-plus-circle me-1"></i>إضافة دور جديد
        </a>
    </div>
    @if (TempData["RoleError"] is string roleError)
    {
        <div class="alert alert-warning" role="alert">@roleError</div>
    }

    <div class="row g-4">
        @foreach (var item in Model)
        {
            <div class="col-lg-6 col-xl-4">
                <div class="role-card h-100">
                    <div class="role-card-header">
                        <span class="role-badge">@item.Name</span>
                        <div class="role-actions">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-primary">تعديل</a>
                            @if (!item.IsSystemRole)
                            {
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('هل تريد حذف هذا الدور؟')">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-danger">حذف</button>
                                </form>
                            }
                        </div>
                    </div>

                    <div class="role-card-body">
                        <div class="role-description">
                            @(string.IsNullOrWhiteSpace(item.Description) ? "لا يوجد وصف لهذا الدور." : item.Description)
                        </div>

                        <div class="permission-label">الصلاحيات</div>
                        <div class="permission-list">
                            @if (item.RolePermissions != null && item.RolePermissions.Any())
                            {
                                foreach (var permission in item.RolePermissions)
                                {
                                    <span class="permission-badge">@permission.Permission.Name</span>
                                }
                            }
                            else
                            {
                                <span class="permission-empty">لا توجد صلاحيات</span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
