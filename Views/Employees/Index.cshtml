@model IEnumerable<Employee>
<div class="d-flex justify-content-between align-items-center mb-3"><h2>الموظفون</h2><a class="btn btn-primary" asp-action="Create">+ موظف جديد</a></div>
<form class="row g-2 mb-3"><div class="col-md-8"><input name="q" value="@ViewBag.Q" class="form-control" placeholder="بحث بالاسم أو القومي أو الموبايل أو المشروع" /></div><div class="col-auto"><button class="btn btn-dark">بحث</button></div></form>
<div class="table-responsive"><table class="table table-hover align-middle"><thead><tr><th>الموظف</th><th>المشروع</th><th>السكن</th><th>الوظيفة</th><th>الحالة</th><th></th></tr></thead><tbody>@foreach(var e in Model){
<tr>
    <td><b>@e.FullName</b><div class="small text-muted">@e.EmployeeCode</div></td>
    <td>@(e.Project?.Name ?? e.ProjectName)</td>
    <td>
        @(e.Room?.Apartment?.Building?.Site?.Name ?? "-")
        @(e.Room?.Apartment?.Building != null ? $"/ عمارة {e.Room.Apartment.Building.Number}" : "")
        @(e.Room?.Apartment != null && e.Room != null ? $"/ شقة {e.Room.Apartment.Number} / غرفة {e.Room.Number}" : "")
    </td>
    <td>@e.JobTitle</td>
    <td><span class="badge @(e.IsActive ? "bg-success" : "bg-secondary")">@(e.IsActive ? "نشط" : "غير نشط")</span></td>
    <td class="text-nowrap"><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@e.Id">تعديل</a> <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@e.Id" onclick="return confirm('حذف الموظف؟')">حذف</a></td>
</tr>
}</tbody></table></div>
