@model IEnumerable<AppUser>

<h2>المستخدمون</h2>
<a asp-action="Create" class="btn btn-success mb-3">إضافة مستخدم جديد</a>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>اسم المستخدم</th>
            <th>الاسم الكامل</th>
            <th>البريد</th>
            <th>الأدوار</th>
            <th>الحالة</th>
            <th>إجراءات</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.UserName</td>
                <td>@item.FullName</td>
                <td>@item.Email</td>
                <td>@string.Join(", ", item.UserRoles.Select(ur => ur.Role.Name))</td>
                <td>@(item.IsActive ? "نشط" : "غير نشط")</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-primary">تعديل</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger" onclick="return confirm('هل تريد حذف هذا المستخدم؟')">حذف</a>
                </td>
            </tr>
        }
    </tbody>
</table>
