@model HousingManagementWeb.Controllers.ErrorViewModel
<div class="card shadow-sm p-4">
    <h2 class="text-danger">حدث خطأ غير متوقع</h2>
    <p class="text-muted">برجاء المحاولة مرة أخرى، أو التواصل مع الدعم الفني إذا تكررت المشكلة.</p>
    @if (Model?.ShowRequestId == true)
    {
        <p><small class="text-muted">Request ID: <code>@Model.RequestId</code></small></p>
    }
    <a class="btn btn-primary" asp-controller="Home" asp-action="Index">العودة للصفحة الرئيسية</a>
</div>
