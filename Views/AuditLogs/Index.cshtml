@model IEnumerable<HousingManagementWeb.Models.AuditLog>

<div class="card shadow-sm border-0">
    <div class="card-header bg-white border-0 d-flex justify-content-between align-items-center py-3">
        <h2 class="mb-0">سجل التعديلات</h2>
        <span class="badge bg-success">للمشرف فقط</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-striped mb-0">
                <thead>
                    <tr>
                        <th>اسم المستخدم</th>
                        <th>الإجراء</th>
                        <th>الكيان</th>
                        <th>التفاصيل</th>
                        <th>التاريخ</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.UserName</td>
                                <td>@item.Action</td>
                                <td>@item.EntityName</td>
                                <td>@item.Details</td>
                                <td>@item.CreatedAt.ToString("yyyy/MM/dd HH:mm")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">لا توجد تعديلات مسجلة.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
