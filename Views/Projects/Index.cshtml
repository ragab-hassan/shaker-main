@model IEnumerable<Project>
<div class="d-flex justify-content-between mb-3"><h2>المشاريع</h2><a class="btn btn-primary" asp-action="Create">+ مشروع جديد</a></div><table class="table bg-white"><thead class="table-dark"><tr><th>المشروع</th><th>الوصف</th><th>الحالة</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.Name</td><td>@x.Description</td><td>@(x.IsActive?"نشط":"متوقف")</td><td><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@x.Id">تعديل</a> <form asp-action="Delete" asp-route-id="@x.Id" method="post" class="d-inline" onsubmit="return confirm('حذف المشروع؟')">@Html.AntiForgeryToken()<button type="submit" class="btn btn-sm btn-outline-danger">حذف</button></form></td></tr>}</tbody></table>
