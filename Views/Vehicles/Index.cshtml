@model IEnumerable<Vehicle>
<div class="d-flex justify-content-between align-items-center mb-3"><h2>العربيات والنقل</h2><a class="btn btn-primary" asp-action="Create">+ عربية جديدة</a></div>
<div class="table-responsive"><table class="table table-hover align-middle"><thead><tr><th>كود السيارة</th><th>رقم السيارة</th><th>النوع</th><th>المشروع</th><th>السائق</th><th>السعة</th><th>خط السير</th><th>الحالة</th><th></th></tr></thead><tbody>@foreach(var v in Model){<tr><td><b>@v.VehicleCode</b></td><td><b>@v.VehicleNumber</b><br /><small class="text-muted">@v.PlateNumber</small></td><td>@v.VehicleType</td><td>@(v.Project?.Name ?? v.ProjectName)</td><td>@(v.DriverEmployee?.FullName ?? v.DriverName)</td><td>@v.Capacity</td><td>@v.Route</td><td><span class="badge @(v.IsActive ? "bg-success" : "bg-secondary")">@(v.IsActive ? "نشطة" : "متوقفة")</span></td><td class="text-nowrap"><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@v.Id">تعديل</a> <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@v.Id" onclick="return confirm('حذف العربية؟')">حذف</a></td></tr>}</tbody></table></div>
